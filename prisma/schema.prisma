generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  username              String?             @unique
  name                  String
  password              String
  role                  String              @default("officer")
  barangay              String?
  phone                 String?
  avatar                String?
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  assignedCases         Case[]              @relation("AssignedOfficer")
  overriddenAssessments CaseAssessment[]    @relation("AssessmentOverride")
  createdReports        Report[]
  activities            Activity[]
  sentMessages          Message[]           @relation("SentMessages")
  receivedMessages      Message[]           @relation("ReceivedMessages")
  caseFollowUps         CaseFollowUp[]
  assessmentActions     AssessmentHistory[] @relation("AssessmentActor")
  presidedHearings      CaseHearing[]       @relation("HearingOfficial")
}

model Case {
  id           String  @id @default(cuid())
  caseNumber   String  @unique
  residentName String
  caseType     String
  status       String  @default("Open")
  /// The queue level: Low | Medium | High | Critical, or null when it is
  /// undetermined - too little is known and no matrix criterion or safety rule
  /// is met. Never defaulted: an unknown risk is not a low one. Cases filed
  /// before this kept the level they had.
  riskLevel    String?
  barangay     String
  description  String
  notes        String?
  /// The language the resident wrote this report in: tagalog | taglish |
  /// english. Read from the text, never from the interface toggle, and used to
  /// decide which language the recommendation comes back in.
  language     String?

  /// Where the incident happened, as picked on the map. Nullable because every
  /// case filed before the picker existed has none, and because a report must
  /// never be blocked on the address lookup being reachable.
  /// `barangay` above still holds the street, which is what cases group by.
  latitude          Float?
  longitude         Float?
  /// The geocoder's full one-line address for the point, kept verbatim.
  locationLabel     String?
  municipality      String?
  province          String?
  assignedToId      String?
  assignedTo        User?               @relation("AssignedOfficer", fields: [assignedToId], references: [id])
  residentId        String?
  resident          Resident?           @relation(fields: [residentId], references: [id])
  filedAt           DateTime            @default(now())
  resolvedAt        DateTime?
  updatedAt         DateTime            @updatedAt
  activities        Activity[]
  notifications     Notification[]
  followUps         CaseFollowUp[]
  attachments       CaseAttachment[]
  assessment        CaseAssessment?
  intake            CaseIntake?
  /// The official's intake interview (intake form.pdf), at most one per case.
  officialIntake    OfficialIntake?
  assessmentHistory AssessmentHistory[]

  /// How much the report actually tells us: INSUFFICIENT | PARTIAL |
  /// SUFFICIENT_FOR_PRELIMINARY_ASSESSMENT. Null on cases filed before the
  /// assisted intake existed. Deliberately separate from riskLevel - a short
  /// report is not a low-risk report, and it is not a high-risk one either.
  informationCompleteness String?
  /// Set when the preliminary assessment needs a person: incomplete,
  /// conflicting, VAWC, or a safety concern. Cleared by an officer review.
  requiresOfficerReview   Boolean @default(false)
  /// Where the preliminary triage stands - set by the server at filing and by
  /// an officer's review, never by the browser:
  ///   URGENT_REVIEW          possible danger now; a person looks first
  ///   NEEDS_FOLLOW_UP        essential details missing; not fully classified
  ///   FOR_REVIEW             enough is known, but the category or level is
  ///                          uncertain or the readings disagree
  ///   PRELIMINARY            enough is known and a level is supported
  ///   ASSESSMENT_UNAVAILABLE the matrix text could not be consulted
  ///   REVIEWED               an officer has confirmed or set the assessment
  /// Null on cases filed before it existed (legacy). Separate from `status`,
  /// which is the case's workflow (Open, In Progress, Resolved...).
  triageStatus            String?

  /// Where the case is heading, from the latest follow-up unless an officer
  /// overrides it: improving | no_change | worsening | resolved.
  progressState        String    @default("no_change")
  lastResidentUpdateAt DateTime?
  lastOfficerActionAt  DateTime?
  /// Stamped when a "you have not updated this" reminder is sent, so the sweep
  /// is idempotent and a resident is never reminded twice for the same silence.
  reminderSentAt       DateTime?

  /// How the reporter says it is safe to reach them, from the report form:
  /// call_ok | text_first | no_phone. Null when they did not say. Officers
  /// see it beside the contact details; it is never inferred.
  contactPreference String?
  /// Their own words: safe times, who may answer, what not to say.
  contactSafetyNote String?

  /// Who the report is for: SELF | THIRD_PARTY | ON_BEHALF | ANONYMOUS. Null
  /// on cases filed before it was asked. The reporter, the affected person
  /// and the accused are separate roles; THIRD_PARTY does not make the
  /// reporter a victim or a witness.
  reportingRelationship    String?
  /// Who was affected, in the reporter's words (optional, never required).
  affectedPersonNote       String?
  /// ANONYMOUS: officials are not shown who filed it. The resident account is
  /// still linked, so the reporter can follow their own report.
  reporterIdentityWithheld Boolean @default(false)

  /// Which form the reporter chose: BLOTTER | VAWC. Their first reading only -
  /// the category and the desk come from what the report says, and a form
  /// that disagrees with the report is flagged for an officer.
  reportPath         String?
  /// How the report reached the barangay: ONLINE | WALK_IN | PHONE | REFERRAL | OTHER.
  reportingChannel   String?
  /// When it happened, if the reporter knows. The day only; the time is the
  /// reporter's own approximation ("around 9 PM"), never made exact.
  incidentDate       DateTime? @db.Date
  incidentTimeApprox String?
  /// How the case was resolved or closed (lib/caseRecords RESOLUTION_TYPES),
  /// recorded with the status change; resolvedAt is set there too.
  resolutionType     String?
  resolutionSummary  String?
  resolvedById       String?
  /// Who saw it, as the reporter described them.
  witnessInfo        String?

  parties          CaseParty[]
  safetyAssessment CaseSafetyAssessment?
  referrals        CaseReferral[]
  hearings         CaseHearing[]
  acknowledgement  AcknowledgementLetter?
  kpReviews        CaseKpReview[]
  pangkat          CasePangkat?
  victimSurvivors  CaseVictimSurvivor[]
  reportAddenda    ReportAddendum[]
  reportDrafts     ReportDraft[]
  clarifications   ClarificationRequest[]
  interviews       CaseInterview[]

  @@index([progressState])
}

/// Report review: everything added to a report after it was filed. The
/// resident's original narrative (CaseIntake.narrative / Case.description) is
/// version 1 and is never changed; each correction, addition, answer to a
/// follow-up question, clarification or recorded interview is a new version
/// here, with the version it follows, what it supplies, who and when.
/// Append-only (prisma/sql/010_report_review.sql).
model ReportAddendum {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// 2, 3, ... - the original report is version 1.
  version         Int
  previousVersion Int
  /// RESIDENT_CORRECTION | RESIDENT_ADDITION | RESIDENT_CLARIFICATION | RESIDENT_ANSWERS | INTERVIEW
  source          String
  /// [{ key, label, value }] or [{ key, label, skipped: true }] - answers to the report's questions, by template field.
  fields          Json
  /// Free text in the person's own words (a correction, an addition, a clarification).
  text            String?
  reason          String?
  /// The authenticated resident, when a resident supplied it.
  residentId      String?
  /// The official, when recorded by one (an interview).
  actorUserId     String?
  /// The clarification request this answers, when it does.
  requestId       String?
  interviewId     String?
  /// It changes what the report says happened - the AI assessment should be run again.
  material        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([caseId, version])
  @@index([caseId])
}

/// An official's request for more information from the resident who filed.
/// Shown in the resident's report details and answered there; delivered only
/// inside SafeComm (no text message or call).
model ClarificationRequest {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedById String
  /// [{ key, label, question }] - what needs clarifying.
  items         Json
  message       String?
  /// OPEN | ANSWERED | CANCELLED
  status        String    @default("OPEN")
  answeredAt    DateTime?
  addendumId    String?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime  @default(now())

  @@index([caseId])
}

/// A follow-up interview or interaction an official recorded. Its answers
/// are also kept as a report version (ReportAddendum, source INTERVIEW).
/// Append-only.
model CaseInterview {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  interviewedAt   DateTime
  /// IN_PERSON | PHONE | SAFECOMM_MESSAGE | HOME_VISIT | OTHER
  contactMethod   String
  /// The official who held the interview.
  interviewerId   String
  /// [{ question, answer }]
  questions       Json
  notes           String?
  followUpActions String?
  recordedById    String
  addendumId      String?
  createdAt       DateTime @default(now())

  @@index([caseId])
}

/// A structured draft of the report in the desk's intake template
/// (lib/reportTemplates.ts), each field marked with where it came from - or
/// NEEDS_CONFIRMATION. Drafts are kept, never rewritten: a new one supersedes
/// the last. Only an official's approval makes one the official report.
model ReportDraft {
  id                 String    @id @default(cuid())
  caseId             String
  case               Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  draftNumber        Int
  /// The latest report version it was built from (1 = the original only).
  basedOnVersion     Int
  /// BLOTTER | VAWC
  template           String
  /// { [templateKey]: { value, status, source, quote, note } }
  fields             Json
  /// SafeComm AI's neutral summary - never a finding.
  summary            String?
  /// ai | rules | official_edit
  generator          String
  aiStatus           String?
  model              String?
  needsConfirmation  Int       @default(0)
  /// What else came with it: the reassessment it triggered, the field an official edited.
  meta               Json?
  /// DRAFT | APPROVED | SUPERSEDED
  status             String    @default("DRAFT")
  createdById        String?
  createdByResident  String?
  createdAt          DateTime  @default(now())
  approvedById       String?
  approvedAt         DateTime?
  approvalNote       String?

  @@unique([caseId, draftNumber])
  @@index([caseId])
}

/// The victim-survivors of a VAWC case, as an official records them - one row
/// per person, so a case can have more than one (a mother and her children).
/// For the women-and-children statistics: sex as recorded (never inferred from
/// a name or the narrative), and age at the incident from a birthdate or as
/// recorded. No name is kept here; the person's details stay in the intake
/// form. `clientCode` (the VAWC client code) is how the same person is
/// recognised across cases - without one, a row counts as its own person.
/// A row is never deleted by the app: a mistaken one is marked removed, with
/// who, when and why. RLS: prisma/sql/009_victim_survivors.sql.
model CaseVictimSurvivor {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// female | male | intersex - null when not recorded.
  sexAtBirth    String?
  /// The birthdate, when known (a date; time ignored).
  birthDate     DateTime?
  /// Age at the incident as recorded, when the birthdate is not known.
  ageAtIncident Int?
  /// The VAWC client code (upper-cased, trimmed) - the same code on two cases is one person.
  clientCode    String?
  /// official | intake (copied from the completed VAWC intake form by an official).
  source        String    @default("official")
  recordedById  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  removedAt     DateTime?
  removedById   String?
  removedReason String?

  @@index([caseId])
  @@index([clientCode])
}

/// A person the report is about, other than the reporter: the person affected
/// (AFFECTED) and the person reported (REPORTED). Kept apart from the
/// reporter's account and never linked to a resident by matching names - the
/// three may be the same person, or not, and only what was said is recorded.
model CaseParty {
  id                    String        @id @default(cuid())
  caseId                String
  case                  Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// AFFECTED | REPORTED
  role                  String
  fullName              String?
  age                   Int?
  address               String?
  /// AFFECTED only: how to reach the victim-survivor, for the VAWC desk.
  contactNumber         String?
  /// AFFECTED: to the reporter. REPORTED: to the person affected.
  relationship          String?
  /// AFFECTED: children or dependents who may be affected - yes | no | unknown.
  dependentsAffected    String?
  details               String?
  /// reporter | official - who supplied this record.
  source                String        @default("reporter")
  updatedById           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  hearingsAsComplainant CaseHearing[] @relation("HearingComplainant")
  hearingsAsRespondent  CaseHearing[] @relation("HearingRespondent")
  /// The party's own SafeComm account, when they have one - linked by an
  /// official from the resident number, never matched by name. Their hearing
  /// notices are delivered there.
  residentId            String?
  resident              Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  residentLinkedById    String?
  residentLinkedAt      DateTime?

  @@index([caseId])
  @@index([residentId])
}

/// The officer's initial safety assessment. Officer-only; one per case, and
/// every save is also kept as an AssessmentHistory row (kind safety_assessment)
/// so an earlier answer is never lost. Answers are yes | no | unknown.
model CaseSafetyAssessment {
  id                     String    @id @default(cuid())
  caseId                 String    @unique
  case                   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  immediateConcern       String
  dependentsAffected     String
  urgentAssistance       String
  medicalNeeded          String
  shelterNeeded          String
  policeOrReferralNeeded String
  additionalConcerns     String?
  initialAction          String?
  assistanceProvided     String?
  protectionActions      String?
  /// yes | no | unknown - a way to reach the victim-survivor has been confirmed safe.
  safeContactConfirmed   String?
  preferredAssistance    String?
  followUpRequirements   String?
  /// Safety planning documentation.
  safetyPlan             String?
  followUpAt             DateTime?
  version                Int       @default(1)
  updatedById            String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

/// A referral to another office - PNP Women and Children Protection Desk,
/// social welfare, health, legal aid, or (blotter only) the Lupon.
model CaseReferral {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  agency      String
  /// The office's name when agency is OTHER.
  agencyOther String?
  referredAt  DateTime
  reason      String?
  /// REFERRED | ACKNOWLEDGED | COMPLETED | DECLINED
  status      String   @default("REFERRED")
  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Annex B - Referral Form (lib/referralForm.ts). All optional: a referral
  /// recorded before the form existed prints with blank lines to fill in.
  /// The receiving office ("To:" is the agency above).
  toAddress           String?
  toContactPerson     String?
  /// The client being referred.
  clientName          String?
  clientAge           Int?
  /// Female | Male | Intersex - as recorded, never inferred.
  clientSex           String?
  clientAddress       String?
  guardianName        String?
  guardianContact     String?
  guardianAddress     String?
  servicesRequested   String?
  /// Where the receiving office sends its feedback (the referring party).
  feedbackTo          String?
  feedbackAddress     String?
  feedbackCellPhone   String?
  feedbackLandline    String?
  feedbackEmail       String?
  feedbackFax         String?
  feedbackContact     String?
  /// The signatory, printed under the signature line.
  referredByName      String?
  referredByDesignation String?
  formUpdatedAt       DateTime?
  formUpdatedById     String?

  @@index([caseId])
}

/**
 * The AI-assisted triage stored with the case, so an officer sees what the
 * assessment was based on rather than only its conclusion. An officer may
 * override the priority; the original is kept alongside the override so the
 * audit trail shows both.
 */
model CaseAssessment {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  priority            String
  immediateThreat     String
  incidentSeverity    String
  recurrence          String
  vulnerability       String
  escalationPotential String
  urgency             String

  summary    String
  reason     String
  /**
   * Detected factors and generated recommendations, as produced.
   */
  detail     Json
  assessedAt DateTime @default(now())

  // Officer override. Null until someone changes it.
  overridePriority String?
  overrideReason   String?
  overriddenById   String?
  overriddenBy     User?     @relation("AssessmentOverride", fields: [overriddenById], references: [id])
  overriddenAt     DateTime?

  @@index([priority])
}

/**
 * A photo filed with a report. The bytes live here rather than on disk because
 * the app runs serverless - a file written into public/uploads is gone on the
 * next request - and no object storage is configured. Kept in its own table so
 * listing cases never drags the image data along.
 */
model CaseAttachment {
  id         String        @id @default(cuid())
  caseId     String
  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Set when the photo came with a follow-up rather than the original report.
  followUpId String?
  followUp   CaseFollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  /// Set when an official attached it to a hearing record - officials only,
  /// never shown to a resident.
  hearingId  String?
  hearing    CaseHearing?  @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  createdAt  DateTime      @default(now())

  @@index([caseId])
}

model Report {
  id            String   @id @default(cuid())
  reportNumber  String   @unique
  title         String
  category      String
  status        String   @default("Pending")
  priority      String   @default("Medium")
  content       String
  submittedById String?
  submittedBy   User?    @relation(fields: [submittedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Resident {
  id                 String                   @id @default(cuid())
  residentNumber     String                   @unique
  firstName          String
  lastName           String
  age                Int
  gender             String
  barangay           String
  address            String
  contactNumber      String?
  email              String?
  username           String?                  @unique
  // Links this resident to their Clerk account. Clerk owns the credentials and
  // email verification; this row holds the barangay profile data.
  clerkId            String?                  @unique
  password           String?
  idDocument         String?
  status             String                   @default("Active")
  riskLevel          String                   @default("Low")
  notes              String?
  emailVerified      Boolean                  @default(false)
  registeredAt       DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  cases              Case[]
  /// Case records an official linked to this account (a respondent with a
  /// SafeComm account, say) - by the resident number, never by name.
  caseParties        CaseParty[]
  hearingNotices     CaseHearingNotice[]
  verificationTokens EmailVerificationToken[]
  followUps          CaseFollowUp[]
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  residentId String
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([residentId])
}

model Activity {
  id         String   @id @default(cuid())
  type       String
  message    String
  entityId   String?
  entityType String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  caseId     String?
  case       Case?    @relation(fields: [caseId], references: [id])
  color      String   @default("#3b82f6")
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  /// The case this is about, when it is about one. Nullable: announcements and
  /// system notices are not. Without it a notification naming a case in its
  /// title could not open that case - the number was only ever text.
  caseId String?
  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Alert {
  id             String    @id @default(cuid())
  title          String
  message        String
  level          String    @default("warning")
  barangay       String?
  active         Boolean   @default(true)
  // Which module published it (blotter / vawc / admin) and the officer who did.
  // Denormalised so the announcement board never needs a join.
  module         String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  // Who it is addressed to: "residents", "officers" or "everyone". Residents
  // must never be shown an officers-only post, so the resident feed filters on
  // this rather than trusting the barangay match alone.
  audience       String    @default("residents")
  // Narrows an officer audience to a single module ("blotter" / "vawc" /
  // "captain"); null means every officer.
  audienceModule String?
}

/// One entry on a case's timeline. Written by the resident who filed it, by an
/// officer, or by the system when a re-assessment changes the risk level.
/// Entries are never deleted - an officer may hide one, with a reason, and the
/// row stays for the audit trail.
model CaseFollowUp {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Exactly one of these is set, except for system entries where neither is.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id])
  /// resident | officer | system
  authorRole String    @default("officer")

  /// follow_up | officer_action | status_change | risk_change
  updateType String  @default("officer_action")
  /// Only on a resident follow-up: still_happening | improving | worsening | resolved
  progress   String?

  type       String  @default("note")
  content    String
  statusFrom String?
  statusTo   String?
  outcome    String?

  /// Officer notes are internal by default; a resident's own update is always
  /// visible to them.
  visibleToReporter Boolean @default(false)

  hiddenAt     DateTime?
  hiddenById   String?
  hiddenReason String?

  attachments CaseAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, createdAt])
}

model Message {
  id          String    @id @default(cuid())
  subject     String
  body        String
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id])
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  parentId    String?
  parent      Message?  @relation("Replies", fields: [parentId], references: [id])
  replies     Message[] @relation("Replies")
}

/// What the resident told the assisted intake, kept exactly as given.
///
/// The original narrative is never edited here or on the Case: a later answer
/// adds to the record, it does not rewrite it. One per case.
model CaseIntake {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// The first thing the resident wrote, verbatim.
  narrative        String
  /// The category the resident chose. Context, not the classification.
  selectedCategory String?
  language         String?
  /// Every question asked, in order, with the answer or how it was left
  /// (answered / skipped / declined / not sure).
  turns            Json

  informationCompleteness String
  suggestedCaseCategory   String?
  /// suggested | needs_review - whether the matrix found a category or
  /// filed it as Other / VAWC - Other for an officer to classify.
  classificationStatus    String  @default("suggested")
  categoryConfidence      String
  /// Facts the report cannot settle that an officer must confirm.
  officerToConfirm        Json?
  /// lib/classificationSchema.ts MATRIX_VERSION at the time.
  matrixVersion           String?
  categoryRationale       Json
  conflicts               Json
  route                   String
  immediateSafetyConcern  Boolean @default(false)
  supportingIndicators    Json
  missingInformation      Json
  recommendedNextSteps    Json
  requiresOfficerReview   Boolean @default(false)
  reviewReasons           Json
  /// Which engine produced this, so an old result can be told from a new one.
  engineVersion           String

  // ── The risk matrix applied (lib/riskMatrices.ts, knowledge base) ──
  /// BLOTTER | VAWC
  framework             String?
  /// 1-5 on that matrix; null when no criterion was met.
  matrixLevel           Int?
  /// The level's label exactly as the source document gives it.
  matrixLabel           String?
  /// Each criterion met, in the document's words, with the resident's words.
  matchedCriteria       Json?
  /// NEEDS_MORE_INFORMATION | PRELIMINARY | FOR_REVIEW
  assessmentStatus      String?
  alternativeCategories Json?
  /// Unknowns that could move the level once answered.
  levelCaveats          Json?
  /// The source passages retrieved for this report, with their scores.
  matrixReferences      Json?
  /// Whether the matched criteria were found in the imported source text.
  sourceVerified        Boolean?
  /// ok | no_match | no_documents | unavailable | empty_query
  knowledgeBaseStatus   String?
  /// What made the assessment: the rules alone, or the rules with the AI reader.
  assessedBy            String?
  /// The AI reader's checked reading at filing (lib/aiClassifier.ts): status,
  /// model, the facts it found with the resident's words, its category. Null
  /// when it did not run.
  aiReading             Json?
  /// The AI interview: every question asked, by round, with the answer, a
  /// skip or "prefer not to answer" - exactly as the resident left it.
  aiInterview           Json?
  /// Urgent human review recommended at filing - by the rules (danger now)
  /// or by the AI assessment.
  urgentReview          Boolean  @default(false)
  createdAt             DateTime @default(now())
}

/// Every assessment a case has had, oldest first. Nothing here is updated or
/// deleted: an officer's override is a new row, and the preliminary result it
/// replaced stays readable underneath it.
model AssessmentHistory {
  id                      String   @id @default(cuid())
  caseId                  String
  case                    Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// preliminary | officer_override | officer_confirm | walk_in |
  /// category_confirm | category_change
  kind                    String
  /// Null when the level was undetermined at this point.
  riskLevel               String?
  /// The case category at this point, and what it was before - so a
  /// reclassification can be read back without reconstructing it.
  caseType                String?
  previousCaseType        String?
  /// The matrix and its level at this point, alongside the queue level.
  framework               String?
  matrixLevel             Int?
  matrixLabel             String?
  informationCompleteness String?
  rationale               Json
  /// Who did it. Null for the automated preliminary assessment.
  actorId                 String?
  actor                   User?    @relation("AssessmentActor", fields: [actorId], references: [id])
  reason                  String?
  engineVersion           String?
  createdAt               DateTime @default(now())

  @@index([caseId, createdAt])
}

/// The risk classification matrices, chunked for search.
///
/// Created by prisma/sql/001_risk_matrix_knowledge_base.sql (which also
/// installs pg_trgm) and filled by scripts/ingest-risk-matrices.ts. Declared
/// here so `prisma db push` keeps the table and its trigram index instead of
/// dropping what it does not recognise. Searched in lib/knowledgeBase.ts.
model RiskMatrixChunk {
  id              String    @id @default(cuid())
  /// BLOTTER | VAWC | TEST
  documentType    String
  documentName    String
  sourceFile      String
  /// sha256 of the source file; one import per file version.
  sourceHash      String
  chunkIndex      Int
  sectionTitle    String
  content         String
  pageNumber      Int?
  /// 1..5 when the chunk is a risk-level row.
  riskLevel       Int?
  /// The label exactly as the document gives it.
  riskLabel       String?
  /// The row's columns, keyed by the document's own headings.
  fields          Json?
  frameworkStatus String
  /// False once a newer version of the same document has been imported.
  isCurrent       Boolean   @default(true)
  importedAt      DateTime  @default(now())
  supersededAt    DateTime?

  @@unique([documentType, sourceHash, chunkIndex])
  @@index([documentType, isCurrent])
  @@index([riskLevel])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// How much of the free AI tier has been used. One row per bucket:
/// "day:YYYY-MM-DD" for the whole app, "resident:<id>:YYYY-MM-DD" for one
/// resident. Counts only - no report text is ever stored here.
model AiUsage {
  bucket    String   @id
  requests  Int      @default(0)
  tokens    Int      @default(0)
  updatedAt DateTime @default(now())
}

/// Every attempt by an official to see a reporter's contact details, permitted
/// or not. Append-only: a database trigger (prisma/sql/002_reporter_access.sql)
/// refuses UPDATE, DELETE and TRUNCATE. It holds no phone number, e-mail or
/// narrative - only who asked, for which case, what kind of detail, and why.
/// Case and user ids are plain columns, not relations, so the record outlives
/// a deleted case or account.
model ReporterAccessLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  /// Null only when the caller could not be identified.
  actorId    String?
  actorRole  String?
  caseId     String
  caseNumber String?
  /// What was asked for: phone | email.
  fields     String[]
  /// permitted | denied
  outcome    String
  /// Why: assigned | oversight | not_assigned | vawc_restricted | inactive |
  /// reason_required | not_found | no_contact_on_file | rate_limited | ...
  code       String
  /// The official's stated reason, when the policy asks for one.
  reason     String?

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

/// The official intake interview for a case, on the barangay's intake form
/// (lib/officialIntakeForm.ts, from "intake form.pdf"). At most one per case -
/// starting it again reopens it, never duplicates it. Separate from
/// CaseIntake, which is what the resident told SafeComm Assist; the original
/// report is never changed by it.
model OfficialIntake {
  id            String                   @id @default(cuid())
  caseId        String                   @unique
  case          Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// The reporter's resident account, taken from the case when the intake
  /// was started. Null for an anonymous or staff-filed report - never looked
  /// up by name.
  residentId    String?
  /// DRAFT | COMPLETED
  status        String                   @default("DRAFT")
  /// Rises by one on every save; a save must name the version it edited, so a
  /// repeated or stale submission cannot overwrite a newer one.
  version       Int                      @default(1)
  formVersion   String
  /// Which form: VAWC_INTAKE (the barangay VAWC intake form) or BLOTTER_REPORT.
  /// Fixed when started, so a draft always reopens as the form it was begun on.
  formType      String                   @default("VAWC_INTAKE")
  /// Item key -> answer (value, "specify" text, or N/A / Unknown / Declined).
  responses     Json
  /// Which answers were filled in from records at the start, and from where.
  prefilled     Json?
  startedById   String
  updatedById   String
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  revisions     OfficialIntakeRevision[]
}

/// Every saved version of an intake, in order. Append-only (database trigger,
/// prisma/sql/003_official_intake.sql): who changed which items, and when.
model OfficialIntakeRevision {
  id          String         @id @default(cuid())
  intakeId    String
  intake      OfficialIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  version     Int
  status      String
  responses   Json
  changedKeys String[]
  changedById String
  createdAt   DateTime       @default(now())

  @@unique([intakeId, version])
}

/// A Katarungang Pambarangay hearing - mediation or conciliation of a blotter
/// dispute. Never a VAWC case: those are not subject to barangay conciliation,
/// and the server refuses one. Hearings 1 to 3, each scheduled by an official
/// only when the one before it calls for it (lib/hearings.ts).
///
/// One row per hearing. A new date is a change to that row, and every change -
/// the old date beside the new one, each notice, attendance, note and outcome -
/// is kept in CaseHearingEvent, which cannot be rewritten.
model CaseHearing {
  id                    String     @id @default(cuid())
  caseId                String
  case                  Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// The hearing's own reference: HRG-<case number>-<hearing number>, with a
  /// suffix when a cancelled hearing is replaced.
  reference             String     @unique
  /// The proceeding's order on the case: 1 for the first, and so on.
  hearingNumber         Int
  /// The Katarungang Pambarangay stage (RA 7160 secs. 410-412):
  /// MEDIATION before the Punong Barangay | CONSTITUTION of the Pangkat |
  /// CONCILIATION before the Pangkat. lib/hearings.ts KP_STAGES.
  stage                 String     @default("MEDIATION")
  /// Which session of that stage this is (a mediation may need more than one).
  session               Int        @default(1)
  /// Date and time, as one instant (shown in Philippine time).
  scheduledAt           DateTime
  venue                 String?
  /// DRAFT | SCHEDULED | NOTICE_ISSUED | ACKNOWLEDGED | RESCHEDULED | COMPLETED | CANCELLED.
  /// Where the hearing stands - not what came of it (outcome) and not the case's status.
  status                String     @default("DRAFT")
  /// "<caseId>:<number>" while the hearing is not cancelled, null after: no
  /// case has two live records of the same hearing.
  activeKey             String?    @unique
  /// "<caseId>" while the hearing is open (not completed or cancelled): one
  /// open hearing per case at a time.
  openKey               String?    @unique
  /// Who presides or handles it.
  assignedOfficialId    String?
  assignedOfficial      User?      @relation("HearingOfficial", fields: [assignedOfficialId], references: [id], onDelete: SetNull)
  /// The parties, by their records on the case - never by name. A null
  /// complainant is the reporter who filed the case.
  complainantPartyId    String?
  complainantParty      CaseParty? @relation("HearingComplainant", fields: [complainantPartyId], references: [id], onDelete: SetNull)
  respondentPartyId     String?
  respondentParty       CaseParty? @relation("HearingRespondent", fields: [respondentPartyId], references: [id], onDelete: SetNull)
  /// PRESENT | ABSENT | EXCUSED | NOT_RECORDED - recorded by an official only.
  complainantAttendance String     @default("NOT_RECORDED")
  respondentAttendance  String     @default("NOT_RECORDED")
  /// lib/hearings.ts HEARING_OUTCOMES, recorded when the hearing is held.
  outcome               String?
  /// What was agreed or what developed (officials only).
  agreements            String?
  /// A short outcome summary the complainant may read in My Hearings.
  outcomeSummary        String?
  /// The case's next step, as the official records it.
  nextAction            String?
  /// The proposed date of the next hearing, when one is to follow.
  nextHearingAt         DateTime?
  /// Extra instructions for the complainant (what to bring, where to go).
  residentInstructions  String?
  /// The reason for the latest cancellation or new date.
  statusReason          String?
  /// An internal note made when scheduling (officials only).
  notes                 String?
  rescheduleCount       Int        @default(0)
  /// The complainant's own answer - WILL_ATTEND | CANNOT_ATTEND. Theirs, not
  /// the official attendance record.
  residentIntent        String?
  residentIntentAt      DateTime?
  /// Stamped when the "hearing is approaching" reminder goes out; cleared on a new date.
  reminderSentAt        DateTime?
  completedAt           DateTime?
  completedById         String?
  cancelledAt           DateTime?
  cancelledById         String?
  createdById           String
  updatedById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  notices     CaseHearingNotice[]
  events      CaseHearingEvent[]
  requests    CaseHearingRequest[]
  attachments CaseAttachment[]

  @@index([caseId])
  @@index([status, scheduledAt])
  @@index([assignedOfficialId])
}

/// A hearing notice to one party. Generating one does not deliver it: it is
/// GENERATED until an official records it as issued, and delivered or
/// acknowledged only when that is recorded (or the complainant acknowledges
/// it in SafeComm). A new date supersedes the notices for the old one.
model CaseHearingNotice {
  id                   String      @id @default(cuid())
  hearingId            String
  hearing              CaseHearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  caseId               String
  /// KP<form>-<case number>-<stage><session>-<C|R|PM><sequence>
  noticeNumber         String      @unique
  /// The KP form this notice is: 8, 9, 10, 11 or 12 (lib/hearings.ts KP_FORMS).
  formNo               Int?
  /// COMPLAINANT | RESPONDENT | PANGKAT_MEMBER
  recipientRole        String
  /// The SafeComm account it was delivered to, when the recipient has one.
  recipientResidentId  String?
  recipientResident    Resident?   @relation(fields: [recipientResidentId], references: [id], onDelete: SetNull)
  /// PANGKAT_MEMBER: which member.
  pangkatMemberId      String?
  /// How it reaches the recipient: SAFECOMM_ACCOUNT (in their account) | OFFICER (handed over or served).
  channel              String?
  /// When the recipient first opened it in SafeComm.
  seenAt               DateTime?
  /// As it stood in the case records when the notice was generated.
  recipientName        String
  /// The date, time and venue this notice is for.
  scheduledAt          DateTime
  venue                String?
  /// GENERATED | ISSUED | DELIVERED | UNDELIVERED | ACKNOWLEDGED | SUPERSEDED
  status               String      @default("GENERATED")
  /// IN_PERSON | SERVED | SAFECOMM | OTHER
  issueMethod          String?
  generatedById        String
  generatedAt          DateTime    @default(now())
  issuedById           String?
  issuedAt             DateTime?
  deliveryRecordedById String?
  deliveryRecordedAt   DateTime?
  deliveryNote         String?
  acknowledgedAt       DateTime?
  /// RESIDENT_APP (the complainant, in SafeComm) | RECORDED (an official, from a signed receipt)
  acknowledgedVia      String?
  supersededAt         DateTime?

  @@index([hearingId])
  @@index([caseId])
  @@index([recipientResidentId])
}

/// Everything that happened to a hearing, in order: scheduled, new date (old
/// and new), notices, attendance, proceedings notes, outcome, the
/// complainant's acknowledgement and requests. Insert-only - a trigger
/// (prisma/sql/006_hearing_management.sql) refuses any change to a row.
model CaseHearingEvent {
  id        String      @id @default(cuid())
  hearingId String
  hearing   CaseHearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  caseId    String
  /// lib/hearings.ts HEARING_EVENT_KINDS
  kind      String
  /// official | resident | system
  actorType String
  actorId   String?
  /// What changed: the value before and after, where there is one.
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime    @default(now())

  @@index([hearingId, createdAt])
  @@index([caseId, createdAt])
}

/// A complainant's request for a new date. It changes nothing on its own: an
/// official approves it (and sets the new date) or declines it.
model CaseHearingRequest {
  id                String      @id @default(cuid())
  hearingId         String
  hearing           CaseHearing @relation(fields: [hearingId], references: [id], onDelete: Cascade)
  caseId            String
  residentId        String
  /// Which party asked: COMPLAINANT | RESPONDENT.
  requesterRole     String      @default("COMPLAINANT")
  reason            String
  /// The dates or times that would suit them, in their own words.
  preferredSchedule String?
  /// PENDING | APPROVED | DECLINED
  status            String      @default("PENDING")
  /// "<hearingId>:<role>" while pending: one open request per hearing and party.
  pendingKey        String?     @unique
  reviewedById      String?
  reviewedAt        DateTime?
  /// The official's answer, which the complainant sees.
  reviewNote        String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([hearingId])
  @@index([status, createdAt])
}

/// An official's review of whether a case may go to Katarungang Pambarangay
/// proceedings. Kept as history; the latest governs, and only while the case
/// still has the category it was reviewed under. Insert-only, like the events.
model CaseKpReview {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// PENDING_REVIEW | NEEDS_VERIFICATION | ELIGIBLE | NOT_ELIGIBLE
  /// (version 1 reviews: ELIGIBLE | NOT_ELIGIBLE only)
  decision     String
  /// The verified category the review was made under.
  caseType     String
  /// lib/hearings.ts KP_CHECKLIST answers. Version 1: { key: true | false };
  /// version 2: { key: YES | NO | UNKNOWN | NOT_APPLICABLE }, unanswered keys left out.
  checklist    Json
  note         String?
  reviewedById String
  createdAt    DateTime @default(now())
  /// 1 = the earlier tick-box checklist, 2 = answers (lib/hearings.ts KP_REVIEW_VERSION).
  version      Int      @default(1)
  /// The official who approved the case for KP proceedings - required for a
  /// version 2 ELIGIBLE review (database CHECK, prisma/sql/008).
  approvedById String?
  approvedAt   DateTime?

  @@index([caseId, createdAt])
}

/// The acknowledgement that a report was received - one per case. It confirms
/// receipt only: no finding, no assessment, and on a VAWC case not even the
/// category, since a letter can be read by someone other than the reporter.
model AcknowledgementLetter {
  id            String    @id @default(cuid())
  caseId        String    @unique
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  letterNumber  String    @unique
  /// GENERATED (not yet given to the reporter) | ISSUED
  status        String    @default("GENERATED")
  /// The name the letter is addressed to, fixed when generated; "The Reporter" when anonymous.
  recipient     String
  generatedById String
  generatedAt   DateTime  @default(now())
  issuedById    String?
  issuedAt      DateTime?
  /// IN_PERSON | PRINTED_PICKUP | DIGITAL | OTHER
  issueMethod   String?

  @@index([status, generatedAt])
}

/// The Pangkat ng Tagapagkasundo constituted for one case (RA 7160 sec. 410(b)
/// and 404): three members chosen from the Lupon, a chairman and a secretary
/// from among them. One per case; constituted when the constitution
/// proceeding is recorded as held with the Pangkat formed.
model CasePangkat {
  id                    String              @id @default(cuid())
  caseId                String              @unique
  case                  Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// The CONSTITUTION proceeding that formed it.
  constitutionHearingId String?
  constitutedAt         DateTime?
  chairmanMemberId      String?
  secretaryMemberId     String?
  createdById           String
  updatedById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  members               CasePangkatMember[]
}

/// A Lupon member chosen for a case's Pangkat. Removed members are kept,
/// with when and why, rather than deleted.
model CasePangkatMember {
  id            String      @id @default(cuid())
  pangkatId     String
  pangkat       CasePangkat @relation(fields: [pangkatId], references: [id], onDelete: Cascade)
  name          String
  /// How chosen: COMPLAINANT | RESPONDENT | BOTH_PARTIES | DRAWN_BY_LOT | PUNONG_BARANGAY
  chosenBy      String
  /// The member's SafeComm staff account, if they have one.
  userId        String?
  addedById     String
  createdAt     DateTime    @default(now())
  removedAt     DateTime?
  removedById   String?
  removedReason String?

  @@index([pangkatId])
}
