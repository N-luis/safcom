# SafeComm — environment variables
#
# Copy to `.env` for local development, and paste the same keys into
# Vercel → Settings → Environment Variables for deployment.
# Never commit the filled-in `.env` — it is gitignored on purpose.

# ─── Clerk (resident identity) ───────────────────────────────────────────────
# REQUIRED. The app's middleware runs clerkMiddleware() on every route, so if
# either key is missing EVERY page returns a blank "Internal Server Error".
# Get both from https://dashboard.clerk.com → your app → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Where Clerk's hosted pages live, and where a resident lands afterwards.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/complete-profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/complete-profile

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# REQUIRED at runtime. Use the POOLER host (port 6543) — a serverless function
# opens a connection per invocation and the direct host will run out.
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
DATABASE_URL=postgresql://USER:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# Only used by the Prisma CLI (`prisma db push`, `prisma migrate`) via
# prisma.config.ts. NOT needed on Vercel.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ─── Sessions ────────────────────────────────────────────────────────────────
# REQUIRED in production. Signs the staff (safcom_token) and resident
# (resident_token) cookies. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start signing sessions in production without it.
JWT_SECRET=

# ─── Email (legacy verification path) ────────────────────────────────────────
# Optional. Only used by the pre-Clerk email verification flow. Safe to omit.
EMAIL_SERVER=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TOKEN_TTL_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_RESEND_DAILY_MAX=5
